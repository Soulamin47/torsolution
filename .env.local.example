# Contact form — option 1: Resend API (recommended on Vercel)
RESEND_API_KEY=
CONTACT_FROM=Torsolution <contact@torsolution.be>
CONTACT_TO=info@torsolution.be

# Contact form — option 2: SMTP fallback (used when RESEND_API_KEY is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
